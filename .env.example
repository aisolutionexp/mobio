# Supabase — Client (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Supabase — Server only (Edge Functions, webhooks, admin scripts)
# NUNCA importar no client ou em Server Actions comuns
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Supabase CLI — Management API (CI/CD)
SUPABASE_ACCESS_TOKEN=sbp_xxx

# Web Push VAPID — gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxx...
VAPID_PRIVATE_KEY=xxx...
VAPID_SUBJECT=mailto:noreply@mobio.com

# Sentry — Observabilidade
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry — CI/CD only (source maps upload)
SENTRY_AUTH_TOKEN=sntrys_xxx
